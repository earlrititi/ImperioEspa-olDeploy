---
import Layout from "../../layouts/Layout.astro";
---

<Layout
  title="Casa de Mercaderias"
  description="Drop 1 Camiseta Imperial de Imperio Español."
>
  <main class="storefront">
    <section class="store-catalog" id="catalogo">
      <header class="store-header">
        <span class="store-mark-spacer" aria-hidden="true"></span>

        <nav class="store-nav" aria-label="Navegacion de la tienda">
          <a href="#mercancias">Mercancias</a>
        </nav>

        <a class="store-account" href="/cuenta">Cuenta</a>
      </header>

      <div class="catalog-heading">
        <p>CASA DE MERCADERÍAS</p>
        <h1>TIENDA</h1>
      </div>

      <div class="product-grid" id="mercancias">
        <article
          class="product-card product-card--shirt"
          data-shirt-card
          id="camiseta"
        >
          <div class="product-meta">
            <strong>DROP 1 CAMISETA IMPERIAL</strong>
          </div>
          <div
            class="product-visual product-visual--shirt"
            role="button"
            tabindex="0"
            aria-haspopup="dialog"
            aria-controls="camiseta-imperial-detalle"
            aria-label="Ampliar Camiseta Imperial"
            data-shirt-detail-open
          >
            <div class="product-shirt-placeholder" aria-hidden="true">
              <img src="/images/logo-redv2.png" alt="" width="180" height="153" />
            </div>
            <div class="product-shirt-scene" aria-hidden="true">
              <div class="product-shirt-scene__frame">
                <img
                  class="product-shirt-scene__start"
                  src="/images/camiseta-escaparate-start.webp"
                  alt=""
                  width="600"
                  height="800"
                />
                <img
                  class="product-shirt-scene__gate"
                  src="/images/verja.webp"
                  alt=""
                  width="600"
                  height="800"
                />
                <img
                  class="product-shirt-scene__facade"
                  src="/images/escaparate.webp"
                  alt=""
                  width="600"
                  height="800"
                />
              </div>
              <div class="product-shirt-final" data-shirt-gallery>
                <img
                  class="product-shirt-final__image product-shirt-final__image--front"
                  src="/images/museo-camiseta-front.webp"
                  alt="Camiseta Imperial vista por delante"
                  width="1400"
                  height="1150"
                />
                <img
                  class="product-shirt-final__image product-shirt-final__image--back"
                  src="/images/museo-camiseta-back.webp"
                  alt="Camiseta Imperial vista por detras"
                  width="1400"
                  height="1150"
                />
                <button
                  class="product-shirt-gallery-next"
                  type="button"
                  aria-label="Mostrar parte trasera de la camiseta"
                  aria-pressed="false"
                  data-shirt-gallery-next
                >
                  <span aria-hidden="true">&#9654;</span>
                </button>
              </div>
            </div>
          </div>
          <div class="product-purchase">
            <p class="product-price">27,99 EUR</p>
            <label class="size-field">
              <span>Talla</span>
              <select data-shirt-size>
                <option value="S">S</option>
                <option value="M" selected>M</option>
                <option value="L">L</option>
                <option value="XL">XL</option>
              </select>
            </label>
            <button
              class="store-button store-button--light"
              type="button"
              data-product="camiseta-imperial"
            >
              Comprar
            </button>
          </div>
        </article>
      </div>

      <p class="checkout-status" data-checkout-status role="status" aria-live="polite"></p>
    </section>
  </main>

  <dialog
    class="shirt-detail"
    id="camiseta-imperial-detalle"
    aria-labelledby="camiseta-imperial-detalle-titulo"
    data-shirt-detail
  >
    <div class="shirt-detail__shell">
      <header class="shirt-detail__header">
        <div>
          <h2 id="camiseta-imperial-detalle-titulo">DROP 1 CAMISETA IMPERIAL</h2>
        </div>

        <div class="shirt-detail__tools" aria-label="Controles de imagen">
          <button
            type="button"
            aria-label="Alejar imagen"
            title="Alejar imagen"
            data-shirt-zoom-out
          >
            <i data-lucide="zoom-out" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            aria-label="Ampliar imagen"
            title="Ampliar imagen"
            data-shirt-zoom-in
          >
            <i data-lucide="zoom-in" aria-hidden="true"></i>
          </button>
          <button
            type="button"
            aria-label="Cerrar vista ampliada"
            title="Cerrar"
            data-shirt-detail-close
          >
            <i data-lucide="x" aria-hidden="true"></i>
          </button>
        </div>
      </header>

      <div class="shirt-detail__stage">
        <div class="shirt-detail__media" data-shirt-detail-media>
          <img
            class="shirt-detail__image shirt-detail__image--front"
            src="/images/camiseta-imperio-frontal.webp"
            alt="Camiseta Imperial vista por delante"
            width="944"
            height="1181"
            decoding="async"
          />
          <img
            class="shirt-detail__image shirt-detail__image--back"
            src="/images/camiseta-imperio-atras.webp"
            alt="Camiseta Imperial vista por detras"
            width="1077"
            height="1211"
            decoding="async"
          />
        </div>

        <button
          class="shirt-detail__arrow"
          type="button"
          aria-label="Mostrar parte trasera de la camiseta"
          aria-pressed="false"
          data-shirt-detail-toggle
        >
          <i data-lucide="chevron-right" aria-hidden="true"></i>
        </button>
      </div>

      <footer class="shirt-detail__footer">
        <span data-shirt-detail-side>Frontal</span>
        <span data-shirt-zoom-value>100%</span>
      </footer>
    </div>
  </dialog>
</Layout>

<script>
  import {
    ChevronRight,
    X,
    ZoomIn,
    ZoomOut,
    createIcons,
  } from "lucide";

  createIcons({
    icons: {
      ChevronRight,
      X,
      ZoomIn,
      ZoomOut,
    },
  });

  const status = document.querySelector("[data-checkout-status]");

  function setStatus(message) {
    if (status) status.textContent = message;
  }

  async function openCheckout(button, payload) {
    if (!(button instanceof HTMLButtonElement)) return;

    const originalText = button.textContent || "Continuar";
    button.disabled = true;
    button.textContent = "Abriendo Stripe...";
    setStatus("");

    try {
      const response = await fetch("/api/create-checkout-session", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify(payload),
      });
      const data = await response.json().catch(() => ({}));

      if (response.ok && data.url) {
        window.location.href = data.url;
        return;
      }

      setStatus(data.error || "No se pudo iniciar el pago.");
    } catch (error) {
      console.error(error);
      setStatus("No se pudo iniciar el pago.");
    } finally {
      button.disabled = false;
      button.textContent = originalText;
    }
  }

  document.querySelectorAll("button[data-product]").forEach((button) => {
    button.addEventListener("click", () => {
      const card = button.closest(".product-card");
      const sizeField = card?.querySelector("[data-shirt-size]");
      const size = sizeField instanceof HTMLSelectElement ? sizeField.value : "";

      openCheckout(button, {
        product: button.getAttribute("data-product"),
        size,
      });
    });
  });

  document.querySelectorAll("[data-shirt-gallery]").forEach((gallery) => {
    const nextButton = gallery.querySelector("[data-shirt-gallery-next]");
    if (!(gallery instanceof HTMLElement) || !(nextButton instanceof HTMLButtonElement)) {
      return;
    }

    nextButton.addEventListener("click", () => {
      const showingBack = gallery.classList.toggle("is-showing-back");
      nextButton.setAttribute("aria-pressed", String(showingBack));
      nextButton.setAttribute(
        "aria-label",
        showingBack
          ? "Mostrar parte delantera de la camiseta"
          : "Mostrar parte trasera de la camiseta"
      );
    });
  });

  const shirtCard = document.querySelector("[data-shirt-card]");
  const shirtDetailOpen = document.querySelector("[data-shirt-detail-open]");
  const shirtDetail = document.querySelector("[data-shirt-detail]");
  const shirtDetailMedia = document.querySelector("[data-shirt-detail-media]");
  const shirtDetailToggle = document.querySelector("[data-shirt-detail-toggle]");
  const shirtDetailClose = document.querySelector("[data-shirt-detail-close]");
  const shirtZoomIn = document.querySelector("[data-shirt-zoom-in]");
  const shirtZoomOut = document.querySelector("[data-shirt-zoom-out]");
  const shirtDetailSide = document.querySelector("[data-shirt-detail-side]");
  const shirtZoomValue = document.querySelector("[data-shirt-zoom-value]");
  const shirtZoomLevels = [1, 1.25, 1.5, 1.75, 2];
  let shirtZoomIndex = 0;
  let shirtDetailShowingBack = false;

  function updateShirtDetail() {
    if (!(shirtDetail instanceof HTMLDialogElement)) return;

    const zoom = shirtZoomLevels[shirtZoomIndex];
    shirtDetail.classList.toggle("is-showing-back", shirtDetailShowingBack);

    if (shirtDetailMedia instanceof HTMLElement) {
      shirtDetailMedia.style.setProperty("--shirt-detail-scale", String(zoom));
    }

    if (shirtDetailToggle instanceof HTMLButtonElement) {
      shirtDetailToggle.setAttribute("aria-pressed", String(shirtDetailShowingBack));
      shirtDetailToggle.setAttribute(
        "aria-label",
        shirtDetailShowingBack
          ? "Mostrar parte delantera de la camiseta"
          : "Mostrar parte trasera de la camiseta"
      );
    }

    if (shirtZoomOut instanceof HTMLButtonElement) {
      shirtZoomOut.disabled = shirtZoomIndex === 0;
    }

    if (shirtZoomIn instanceof HTMLButtonElement) {
      shirtZoomIn.disabled = shirtZoomIndex === shirtZoomLevels.length - 1;
    }

    if (shirtDetailSide) {
      shirtDetailSide.textContent = shirtDetailShowingBack ? "Trasera" : "Frontal";
    }

    if (shirtZoomValue) {
      shirtZoomValue.textContent = `${Math.round(zoom * 100)}%`;
    }
  }

  function openShirtDetail() {
    if (!(shirtDetail instanceof HTMLDialogElement) || shirtDetail.open) return;

    const cardGallery = shirtCard?.querySelector("[data-shirt-gallery]");
    shirtDetailShowingBack =
      cardGallery instanceof HTMLElement &&
      cardGallery.classList.contains("is-showing-back");
    shirtZoomIndex = 0;
    updateShirtDetail();
    shirtDetail.showModal();
    document.documentElement.classList.add("has-shirt-detail-open");
  }

  function closeShirtDetail() {
    if (!(shirtDetail instanceof HTMLDialogElement) || !shirtDetail.open) return;
    shirtDetail.close();
  }

  shirtCard?.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    if (event.target.closest("button, a, input, select, label")) return;
    openShirtDetail();
  });

  shirtDetailOpen?.addEventListener("keydown", (event) => {
    if (!(event instanceof KeyboardEvent)) return;
    if (event.key !== "Enter" && event.key !== " ") return;
    event.preventDefault();
    openShirtDetail();
  });

  shirtDetailToggle?.addEventListener("click", () => {
    shirtDetailShowingBack = !shirtDetailShowingBack;
    shirtZoomIndex = 0;
    updateShirtDetail();
  });

  shirtZoomIn?.addEventListener("click", () => {
    shirtZoomIndex = Math.min(shirtZoomIndex + 1, shirtZoomLevels.length - 1);
    updateShirtDetail();
  });

  shirtZoomOut?.addEventListener("click", () => {
    shirtZoomIndex = Math.max(shirtZoomIndex - 1, 0);
    updateShirtDetail();
  });

  shirtDetailClose?.addEventListener("click", closeShirtDetail);

  shirtDetail?.addEventListener("click", (event) => {
    if (event.target === shirtDetail) closeShirtDetail();
  });

  shirtDetail?.addEventListener("close", () => {
    document.documentElement.classList.remove("has-shirt-detail-open");
  });
</script>

<style>
  :global(body) {
    background: #0a0a0a;
  }

  :global(html.has-shirt-detail-open) {
    overflow: hidden;
  }

  :global(#imperio-scrollbar-track) {
    background: rgba(255, 255, 255, 0.08);
  }

  .storefront {
    padding: 0;
    color: #f7f7f4;
    background: #0a0a0a;
  }

  .store-catalog {
    min-height: 94svh;
    padding: 0 clamp(1.25rem, 4.2vw, 5rem) clamp(5rem, 8vw, 9rem);
    background: #0a0a0a;
  }

  .store-header {
    min-height: 84px;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: 2rem;
    border-bottom: 1px solid #2b2b2b;
  }

  .store-mark-spacer {
    width: 58px;
    justify-self: start;
  }

  .store-nav {
    display: flex;
    align-items: center;
    gap: clamp(1.25rem, 3vw, 3.5rem);
    color: #8c8c8c;
    font-size: 0.86rem;
    text-transform: uppercase;
  }

  .store-nav a,
  .store-account {
    transition: color 180ms ease;
  }

  .store-nav a:hover,
  .store-account:hover {
    color: #f23b20;
  }

  .store-account {
    justify-self: end;
    color: #f7f7f4;
    font-size: 0.86rem;
    text-transform: uppercase;
  }

  .catalog-heading {
    display: grid;
    grid-template-columns: minmax(0, 0.65fr) minmax(0, 2.35fr);
    align-items: end;
    gap: 2rem;
    padding: clamp(3.5rem, 8vw, 8rem) 0 clamp(3rem, 6vw, 6rem);
  }

  .catalog-heading p {
    margin: 0 0 0.8rem;
    color: #7d7d7d;
    font-family: var(--font-body);
    font-size: 0.9rem;
    font-weight: 500;
    text-transform: uppercase;
  }

  .catalog-heading h1 {
    margin: 0;
    color: #f7f7f4;
    font-family: var(--font-display);
    font-size: clamp(4rem, 9vw, 10rem);
    font-weight: 500;
    line-height: 0.76;
    letter-spacing: 0;
  }

  .product-grid {
    display: grid;
    grid-template-columns: minmax(0, 440px);
  }

  .product-card {
    min-width: 0;
  }

  .product-meta {
    min-height: 58px;
    display: grid;
    align-content: end;
    margin-bottom: 1rem;
  }

  .product-meta strong {
    color: #f7f7f4;
    font: 600 clamp(0.88rem, 1.25vw, 1.12rem)/1.25 var(--font-body);
  }

  .product-visual {
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 6px;
    background: #1c1c1c;
  }

  .product-visual--shirt {
    --shirt-gate-duration: 6000ms;
    --shirt-gate-delay: 1200ms;
    --shirt-zoom-duration: 4000ms;
    --shirt-zoom-gap: 100ms;
    --shirt-final-lead: 600ms;
    --shirt-final-duration: 3400ms;
    position: relative;
    background: #efefeb;
    cursor: zoom-in;
  }

  .product-shirt-placeholder {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    opacity: 1;
    transition: opacity 280ms ease;
  }

  .product-shirt-placeholder img {
    width: min(40%, 180px);
    height: auto;
  }

  .product-shirt-scene {
    position: absolute;
    inset: 0;
    overflow: hidden;
    background: #17120d;
    opacity: 0;
    transition: opacity 280ms ease;
  }

  .product-shirt-scene__frame {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 2;
    width: 100%;
    aspect-ratio: 3 / 4;
    transform-origin: 50% 62%;
    transform: translate(-50%, -50%);
    transition: transform 700ms cubic-bezier(0.22, 1, 0.36, 1);
    will-change: transform;
  }

  .product-shirt-scene__start,
  .product-shirt-scene__gate,
  .product-shirt-scene__facade {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    user-select: none;
    pointer-events: none;
  }

  .product-shirt-scene__start {
    z-index: 1;
  }

  .product-shirt-scene__gate {
    z-index: 2;
    transform: translateY(var(--shirt-gate-offset, 0%));
    transition: transform 1400ms linear;
    will-change: transform;
  }

  .product-shirt-scene__facade {
    z-index: 3;
  }

  .product-card--shirt:hover .product-shirt-placeholder,
  .product-card--shirt:focus-within .product-shirt-placeholder {
    opacity: 0;
  }

  .product-card--shirt:hover .product-shirt-scene,
  .product-card--shirt:focus-within .product-shirt-scene {
    opacity: 1;
  }

  .product-card--shirt:hover,
  .product-card--shirt:focus-within {
    --shirt-gate-offset: -36%;
  }

  .product-card--shirt:hover .product-shirt-scene__gate,
  .product-card--shirt:focus-within .product-shirt-scene__gate {
    transition-duration: var(--shirt-gate-duration);
    transition-delay: var(--shirt-gate-delay);
  }

  .product-shirt-final {
    position: absolute;
    inset: 0;
    z-index: 3;
    overflow: hidden;
    background: #17120d;
    opacity: 0;
    pointer-events: none;
    transition: opacity 500ms ease;
  }

  .product-shirt-final__image {
    position: absolute;
    inset: 0;
    display: block;
    width: 100%;
    height: 100%;
    max-width: none;
    object-fit: cover;
    object-position: center;
    transform: scale(0.82);
    transition:
      opacity 360ms ease,
      transform 700ms ease;
    will-change: transform;
  }

  .product-shirt-final__image--front {
    z-index: 1;
    opacity: 1;
  }

  .product-shirt-final__image--back {
    z-index: 2;
    opacity: 0;
  }

  .product-shirt-final.is-showing-back .product-shirt-final__image--front {
    opacity: 0;
  }

  .product-shirt-final.is-showing-back .product-shirt-final__image--back {
    opacity: 1;
  }

  .product-shirt-gallery-next {
    position: absolute;
    top: 50%;
    right: clamp(0.65rem, 2vw, 1.15rem);
    z-index: 4;
    display: grid;
    place-items: center;
    width: 44px;
    height: 52px;
    padding: 0;
    border: 0;
    color: #fff;
    background: transparent;
    opacity: 0;
    visibility: hidden;
    transform: translate(10px, -50%);
    cursor: pointer;
    pointer-events: none;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.82);
    transition:
      opacity 180ms ease,
      transform 180ms ease,
      visibility 0s linear 180ms;
  }

  .product-shirt-gallery-next span {
    display: block;
    font-size: 1.4rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .product-shirt-final.is-showing-back .product-shirt-gallery-next {
    right: auto;
    left: clamp(0.65rem, 2vw, 1.15rem);
  }

  .product-shirt-final.is-showing-back .product-shirt-gallery-next span {
    transform: rotate(180deg);
  }

  .product-shirt-gallery-next:hover,
  .product-shirt-gallery-next:focus-visible {
    color: #f23b20;
  }

  .product-shirt-gallery-next:focus-visible {
    outline: 2px solid #fff;
    outline-offset: 3px;
  }

  .product-card--shirt:hover .product-shirt-scene__frame,
  .product-card--shirt:focus-within .product-shirt-scene__frame {
    transform: translate(-50%, -50%) scale(2.85);
    transition-duration: var(--shirt-zoom-duration);
    transition-delay: calc(
      var(--shirt-gate-delay) + var(--shirt-gate-duration) +
        var(--shirt-zoom-gap)
    );
  }

  .product-card--shirt:hover .product-shirt-final,
  .product-card--shirt:focus-within .product-shirt-final {
    opacity: 1;
    transition-duration: var(--shirt-final-duration);
    transition-delay: calc(
      var(--shirt-gate-delay) + var(--shirt-gate-duration) +
        var(--shirt-zoom-gap) + var(--shirt-final-lead)
    );
  }

  .product-card--shirt:hover .product-shirt-final__image,
  .product-card--shirt:focus-within .product-shirt-final__image {
    transform: scale(1);
    transition-duration: 360ms, var(--shirt-final-duration);
    transition-delay:
      0ms,
      calc(
        var(--shirt-gate-delay) + var(--shirt-gate-duration) +
          var(--shirt-zoom-gap) + var(--shirt-final-lead)
      );
  }

  .product-card--shirt:hover .product-shirt-gallery-next,
  .product-card--shirt:focus-within .product-shirt-gallery-next {
    opacity: 1;
    visibility: visible;
    transform: translate(0, -50%);
    pointer-events: auto;
    transition-delay:
      calc(
        var(--shirt-gate-delay) + var(--shirt-gate-duration) +
          var(--shirt-zoom-gap) + var(--shirt-zoom-duration)
      ),
      calc(
        var(--shirt-gate-delay) + var(--shirt-gate-duration) +
          var(--shirt-zoom-gap) + var(--shirt-zoom-duration)
      ),
      calc(
        var(--shirt-gate-delay) + var(--shirt-gate-duration) +
          var(--shirt-zoom-gap) + var(--shirt-zoom-duration)
      );
  }

  .shirt-detail {
    width: min(94vw, 1440px);
    height: min(92svh, 980px);
    max-width: none;
    max-height: none;
    padding: 0;
    border: 1px solid #303030;
    border-radius: 6px;
    color: #f7f7f4;
    background: #111;
    overflow: hidden;
  }

  .shirt-detail::backdrop {
    background: rgba(0, 0, 0, 0.84);
    backdrop-filter: blur(5px);
  }

  .shirt-detail__shell {
    display: grid;
    grid-template-rows: auto minmax(0, 1fr) auto;
    width: 100%;
    height: 100%;
  }

  .shirt-detail__header,
  .shirt-detail__footer {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    justify-content: space-between;
    background: #111;
  }

  .shirt-detail__header {
    min-height: 76px;
    padding: 0.9rem clamp(1rem, 2vw, 1.8rem);
    border-bottom: 1px solid #2b2b2b;
  }

  .shirt-detail__header span,
  .shirt-detail__footer {
    color: #858585;
    font: 500 0.75rem/1.2 var(--font-body);
  }

  .shirt-detail__header h2 {
    margin: 0.2rem 0 0;
    color: #f7f7f4;
    font: 600 clamp(0.95rem, 1.4vw, 1.2rem)/1.2 var(--font-body);
  }

  .shirt-detail__tools {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  .shirt-detail__tools button,
  .shirt-detail__arrow {
    display: grid;
    place-items: center;
    padding: 0;
    border: 0;
    color: #f7f7f4;
    background: transparent;
    cursor: pointer;
  }

  .shirt-detail__tools button {
    width: 42px;
    height: 42px;
  }

  .shirt-detail__tools button:hover,
  .shirt-detail__tools button:focus-visible,
  .shirt-detail__arrow:hover,
  .shirt-detail__arrow:focus-visible {
    color: #f23b20;
  }

  .shirt-detail__tools button:focus-visible,
  .shirt-detail__arrow:focus-visible {
    outline: 2px solid currentColor;
    outline-offset: 2px;
  }

  .shirt-detail__tools button:disabled {
    color: #555;
    cursor: default;
  }

  .shirt-detail__tools svg {
    width: 21px;
    height: 21px;
    stroke-width: 1.8;
  }

  .shirt-detail__stage {
    position: relative;
    min-height: 0;
    overflow: hidden;
    background: #ededeb;
  }

  .shirt-detail__media {
    --shirt-detail-scale: 1;
    position: absolute;
    inset: 0;

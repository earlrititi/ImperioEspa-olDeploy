---
import { PRELOADER_SESSION_KEY } from "../config/hero";
import { withBase } from "../utils/basePath";

const preloaderSessionKey = PRELOADER_SESSION_KEY;
---

<a
  class="global-home-mark"
  href={withBase("/")}
  aria-label="Volver al hero"
  title="Volver al hero"
  data-return-to-hero
>
  <img
    class="global-home-mark__image"
    src={withBase("/images/logo-redv2.png")}
    alt=""
    aria-hidden="true"
    width="602"
    height="477"
  />
</a>

<script is:inline define:vars={{ preloaderSessionKey }}>
  if (!window.__imperioHeroReturnBound) {
    window.__imperioHeroReturnBound = true;
    document.addEventListener("click", (event) => {
      const target = event.target;
      const link =
        target instanceof Element ? target.closest("[data-return-to-hero]") : null;

      if (!link) return;

      try {
        window.sessionStorage.setItem(preloaderSessionKey, "1");
      } catch {
        // El enlace sigue funcionando si el navegador bloquea el storage.
      }
    });
  }
</script>

<style>
  .global-home-mark {
    position: fixed;
    top: max(clamp(1rem, 2.25vw, 2rem), env(safe-area-inset-top));
    left: max(clamp(1rem, 2.25vw, 2rem), env(safe-area-inset-left));
    z-index: 175;
    display: grid;
    place-items: center;
    width: clamp(3rem, 4.4vw, 4.5rem);
    aspect-ratio: 602 / 477;
    color: inherit;
    background: transparent;
    border: 0;
    filter: drop-shadow(0 2px 5px rgba(255, 255, 255, 0.24));
    transition: opacity 160ms ease, transform 160ms ease;
  }

  .global-home-mark:hover,
  .global-home-mark:focus-visible {
    opacity: 0.76;
    transform: translateY(-2px);
  }

  .global-home-mark:focus-visible {
    outline: 2px solid var(--color-red-accent);
    outline-offset: 5px;
  }

  .global-home-mark__image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  :global(body:has(#main-nav) .global-home-mark) {
    display: none;
  }

  :global(body:has(.in-work-page) .global-home-mark),
  :global(body:has(.storefront) .global-home-mark) {
    filter: drop-shadow(0 2px 5px rgba(0, 0, 0, 0.88));
  }

  :global(body:has(.in-work-page) .global-home-mark__image),
  :global(body:has(.storefront) .global-home-mark__image) {
    filter: brightness(0) invert(1);
  }

  @media (max-width: 600px) {
    .global-home-mark {
      width: 3.25rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .global-home-mark {
      transition: none;
    }
  }
</style>
